{
  "name": "vicent-art-tattoo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "lint": "vp lint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "vp lint . --fix",
    "format": "vp check --fix",
    "format:check": "vp check --deny-warnings",
    "type-check": "tsc --build --noEmit",
    "check-all": "vp run check && vp run type-check",
    "preview": "vp preview",
    "prepare": "vp config && vp fmt AGENTS.md",
    "check": "vp check --deny-warnings",
    "test": "vp test",
    "test:watch": "vp test watch"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.3",
    "@tailwindcss/vite": "^4.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.3.1",
    "tailwindcss": "^4.1.13"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.7.1",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^6.1.2",
    "daisyui": "^5.1.13",
    "globals": "^16.3.0",
    "oxc-transform-react": "^0.152.0",
    "tw-animate-css": "^1.3.8",
    "typescript": "~5.8.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  }
}
