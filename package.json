{
  "name": "vicent-art-tattoo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "tsc -b && vp build",
    "lint": "vp lint . --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "vp lint . --fix",
    "lint:tailwind:fix": "vpx tailwind-lint --config ./src/global.css \"src/**/*.{ts,tsx}\" --fix",
    "format": "vp check --fix",
    "format:check": "vp check --deny-warnings",
    "tsc": "tsc --build --noEmit",
    "preview": "vp preview",
    "prepare": "vp config && vp fmt --no-error-on-unmatched-pattern AGENTS.md",
    "check": "vp check --deny-warnings",
    "check-all": "vp run check && vp run tsc && vp run lint:tailwind",
    "test": "vp test",
    "test:watch": "vp test watch",
    "lint:tailwind": "vpx tailwind-lint --config ./src/global.css \"src/**/*.{ts,tsx}\"",
    "test:e2e": "vp run build && playwright test",
    "prepare:ink-views": "vpx scripts/prepare-tattoo-views.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.544.0",
    "motion": "^14.9.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@stylistic/eslint-plugin": "5.7.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "globals": "^16.5.0",
    "oxc-transform-react": "^0.152.0",
    "shadcn": "^4.23.0",
    "tailwind-lint": "0.16.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "workspaces": {
    "catalog": {
      "vite": "npm:@voidzero-dev/vite-plus-core@^1.5.0",
      "vite-plus": "^1.5.0"
    }
  },
  "overrides": {
    "vite@*": "catalog:",
    "@tailwindcss/language-service@0.16.0>@csstools/media-query-list-parser": "3.0.1"
  }
}
